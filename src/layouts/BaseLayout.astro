---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** URL de esta misma página en cada idioma (para el selector y hreflang). */
  alternates: Record<Lang, string>;
}

const { lang, title, description, alternates } = Astro.props;
const absolute = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = absolute(alternates[lang]);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#12315b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.site &&
        Object.entries(alternates).map(([hreflang, path]) => (
          <link rel="alternate" hreflang={hreflang} href={absolute(path)} />
        ))
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<script>
  // Recuerda el idioma elegido para la redirección de la raíz.
  document.querySelectorAll<HTMLAnchorElement>('.language a').forEach((link) =>
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('storyLanguage', link.lang);
      } catch {}
    }),
  );
</script>

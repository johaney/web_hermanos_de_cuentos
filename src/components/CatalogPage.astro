---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from './StoryCard.astro';
import Ornament from './Ornament.astro';
import heroImage from '../assets/hermanos-leyendo.png';
import { ui, homeUrl, type Lang, type Category } from '../i18n/ui';
import { getStories } from '../lib/stories';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const stories = await getStories();
const filters = Object.keys(t.categories) as Category[];
---

<BaseLayout
  lang={lang}
  title={t.siteTitle}
  description={t.siteDescription}
  alternates={{ es: homeUrl('es'), en: homeUrl('en') }}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hand">{t.eyebrow}</p>
        <h1>{t.heroTitle} <em>{t.heroTitleEm}</em></h1>
        <p class="hero-body">{t.heroBody}</p>
        <a class="button" href="#catalogo">
          {t.explore}
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 3v13M4 10.5l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
      <figure class="hero-art">
        <Image
          src={heroImage}
          alt={t.heroAlt}
          widths={[640, 960, 1280, 1536]}
          sizes="(max-width: 800px) 100vw, 640px"
          format="webp"
          quality={78}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="wrap catalog" id="catalogo">
    <div class="intro">
      <div>
        <h2>{t.catalogTitle}</h2>
        <p>{t.catalogBody}</p>
      </div>
      <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="M15.5 15.5l5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="search" type="search" placeholder={t.search} aria-label={t.search} />
      </label>
    </div>
    <div class="filters" role="group" aria-label={t.filtersLabel}>
      {
        filters.map((c) => (
          <button type="button" class="tab" data-filter={c} aria-pressed={c === 'todos'}>
            {t.categories[c]}
          </button>
        ))
      }
    </div>
    <div class="cards" id="cards">
      {stories.map((story) => <StoryCard story={story} lang={lang} />)}
    </div>
    <p class="empty" id="empty" hidden>{t.empty}</p>
    <aside class="note">
      <Ornament />
      <h3>{t.noteTitle}</h3>
      <p>{t.noteBody}</p>
      <p class="hand">{t.noteSmall}</p>
    </aside>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const validFilters = chips.map((chip) => chip.dataset.filter);

  const params = new URLSearchParams(location.search);
  let current = validFilters.includes(params.get('categoria') ?? '') ? params.get('categoria')! : 'todos';

  function render() {
    const query = search.value.trim().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
    chips.forEach((chip) => chip.setAttribute('aria-pressed', String(chip.dataset.filter === current)));
    let visible = 0;
    for (const card of cards) {
      const show =
        (current === 'todos' || card.dataset.category === current) &&
        card.dataset.search!.includes(query);
      card.hidden = !show;
      if (show) visible++;
    }
    empty.hidden = visible > 0;
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      current = chip.dataset.filter!;
      const url = new URL(location.href);
      if (current === 'todos') url.searchParams.delete('categoria');
      else url.searchParams.set('categoria', current);
      history.replaceState(null, '', url);
      render();
    }),
  );
  search.addEventListener('input', render);
  render();
</script>

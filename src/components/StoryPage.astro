---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryFormats from './StoryFormats.astro';
import StoryCover from './StoryCover.astro';
import Ornament from './Ornament.astro';
import NarrationPlayer from './NarrationPlayer.astro';
import RecommendedBook from './RecommendedBook.astro';
import { ui, homeUrl, storyUrl, ageLabel, type Lang } from '../i18n/ui';
import type { Story } from '../lib/stories';

interface Props {
  story: Story;
  lang: Lang;
}

const { story, lang } = Astro.props;
const t = ui[lang];
const entry = story.versions[lang];
const v = entry.data;
const { Content } = await render(entry);
const narration = story.narration[lang];
---

<BaseLayout
  lang={lang}
  title={`${v.titulo} — Hermanos de cuento`}
  description={v.descripcion}
  alternates={{
    es: storyUrl('es', story.versions.es.data.slug),
    en: storyUrl('en', story.versions.en.data.slug),
  }}
>
  <article class="story">
    <div class="story-inner">
      <a class="back" href={`${homeUrl(lang)}#catalogo`}>{t.back}</a>
      <header class="story-head">
        <p class="meta">
          <span class="tag">{t.categories[v.categoria]}</span>
          <span>{v.minutos} {t.min.toLowerCase()}</span>
          <span>{ageLabel(lang, v.edad)}</span>
        </p>
        <h1>{v.titulo}</h1>
        <p class="story-lead">{v.descripcion}</p>
        <Ornament />
      </header>
      <StoryCover story={story} variant="page" />
      <StoryFormats lang={lang} title={v.titulo} youtube={v.youtube}>
        {narration && <NarrationPlayer lang={lang} src={narration} />}
        <div class="story-text"><Content /></div>
        <p class="the-end">{t.theEnd}</p>
      </StoryFormats>
      <aside class="reflection" aria-labelledby="reflection-title">
        <h2 class="hand" id="reflection-title">{t.reflection}</h2>
        <p class="reflection-intro">{t.reflectionIntro}</p>
        <ol>
          {v.preguntas.map((q) => <li>{q}</li>)}
        </ol>
      </aside>
      {v.libro && <RecommendedBook lang={lang} book={v.libro} color={v.color} />}
      <a class="back" href={`${homeUrl(lang)}#catalogo`}>{t.again}</a>
    </div>
  </article>
</BaseLayout>

---
import type { categories } from '../content.config';

// Dibujos de línea provisionales para los cuentos sin portada ilustrada.
interface Props {
  category: (typeof categories)[number];
}

const { category } = Astro.props;
---

<svg class="motif" viewBox="0 0 200 140" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
    {
      category === 'tradicionales' && (
        <>
          <path d="M158 20a15 15 0 1 0 10 24 12 12 0 1 1-10-24z" fill="var(--motif-accent)" stroke="none" />
          <path d="M18 116c38-9 70 5 104-2s44-6 62 1" />
          <path d="M58 112l2-18M58 96L40 100c6-8 12-14 16-22L46 80c8-9 12-18 12-30 3 12 8 21 14 30l-10-2c4 8 9 14 15 22z" fill="var(--motif-fill)" />
          <path d="M100 115l1-14M101 102l-13 3c5-7 9-12 11-19l-7 1c6-7 9-14 9-24 3 10 6 17 11 24l-7-1c2 7 6 12 11 19z" fill="var(--motif-fill)" />
          <path d="M138 112l1-12M139 101l-11 2c4-6 8-10 10-16l-6 1c5-6 7-12 7-20 2 8 5 14 9 20l-6-1c2 6 5 10 9 16z" fill="var(--motif-fill)" />
          <path d="M28 34l2 5 5 2-5 2-2 5-2-5-5-2 5-2zM112 26l1.5 3.5 3.5 1.5-3.5 1.5-1.5 3.5-1.5-3.5-3.5-1.5 3.5-1.5z" fill="var(--motif-accent)" stroke="none" />
        </>
      )
    }
    {
      category === 'biblicos' && (
        <>
          <path d="M100 14l5.5 19.5L125 39l-19.5 5.5L100 64l-5.5-19.5L75 39l19.5-5.5z" fill="var(--motif-accent)" stroke="none" />
          <path d="M100 72v6M84 68l-3 5M116 68l3 5" />
          <path d="M12 120c22-26 52-36 80-18 10 6 18 12 26 12" fill="var(--motif-fill)" />
          <path d="M92 118c24-28 58-34 96-10" fill="var(--motif-fill)" />
          <path d="M150 104c1-8 0-14-3-20M147 84c-6-2-11 0-14 4M147 84c5-4 11-4 15 0M147 84c-2-5-6-8-11-8M147 84c3-4 8-6 13-4" />
          <path d="M40 30l1.5 3.5 3.5 1.5-3.5 1.5-1.5 3.5-1.5-3.5-3.5-1.5 3.5-1.5zM160 22l1.5 3.5 3.5 1.5-3.5 1.5-1.5 3.5-1.5-3.5-3.5-1.5 3.5-1.5z" fill="var(--motif-accent)" stroke="none" />
        </>
      )
    }
    {
      category === 'valores' && (
        <>
          <circle cx="46" cy="40" r="11" fill="var(--motif-accent)" stroke="none" />
          <path d="M46 20v-6M46 66v-6M26 40h-6M72 40h-6M32 26l-4-4M64 58l-4-4M32 54l-4 4M64 22l-4 4" />
          <path d="M28 116c30-8 60 3 88-2s46-4 60 0" />
          <path d="M101 114c-1-18-3-32 0-50" />
          <path d="M100 84c-10-16-28-18-36-10 8 12 24 16 36 10z" fill="var(--motif-fill)" />
          <path d="M101 70c8-16 26-20 36-12-6 12-22 18-36 12z" fill="var(--motif-fill)" />
          <path d="M152 48c-9-6-11-14-5-17 3-1 5 1 5 3 0-2 2-4 5-3 6 3 4 11-5 17z" fill="var(--motif-accent)" stroke="none" />
        </>
      )
    }
  </g>
</svg>

---
import { ui, storyUrl, ageLabel, type Lang } from '../i18n/ui';
import type { Story } from '../lib/stories';

interface Props {
  story: Story;
  lang: Lang;
}

const { story, lang } = Astro.props;
const t = ui[lang];
const v = story.versions[lang].data;
// El buscador encuentra el cuento en cualquiera de los dos idiomas y sin importar las tildes.
const searchText = Object.values(story.versions)
  .flatMap(({ data }) => [data.titulo, data.etiqueta, data.descripcion])
  .join(' ')
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .toLowerCase();
---

<div class="card" data-category={v.categoria} data-search={searchText}>
  <div class="cover" style={`background:${v.color}`} aria-hidden="true">
    <span class="motif">{v.emoji}</span>
  </div>
  <div class="card-body">
    <div class="meta">{t.categories[v.categoria].toUpperCase()} · {v.minutos} {t.min} · {ageLabel(lang, v.edad)}</div>
    <h3>{v.titulo}</h3>
    <p>{v.descripcion}</p>
    <a class="read" href={storyUrl(lang, v.slug)} aria-label={`${t.readA} ${v.titulo}`}>{t.read}</a>
  </div>
</div>

---
import StoryCover from './StoryCover.astro';
import { ui, storyUrl, ageLabel, type Lang } from '../i18n/ui';
import type { Story } from '../lib/stories';

interface Props {
  story: Story;
  lang: Lang;
}

const { story, lang } = Astro.props;
const t = ui[lang];
const v = story.versions[lang].data;
// El buscador encuentra el cuento en cualquiera de los dos idiomas y sin importar las tildes.
const searchText = Object.values(story.versions)
  .flatMap(({ data }) => [data.titulo, data.etiqueta, data.descripcion])
  .join(' ')
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .toLowerCase();
---

<article class="card" data-category={v.categoria} data-search={searchText}>
  <StoryCover story={story} variant="card" />
  <div class="card-body">
    <p class="meta">
      <span class="tag">{t.categories[v.categoria]}</span>
      <span>{v.minutos} {t.min.toLowerCase()}</span>
      <span>{ageLabel(lang, v.edad)}</span>
    </p>
    <h3><a href={storyUrl(lang, v.slug)}>{v.titulo}</a></h3>
    <p class="desc">{v.descripcion}</p>
    <span class="read" aria-hidden="true">{t.read}</span>
  </div>
</article>

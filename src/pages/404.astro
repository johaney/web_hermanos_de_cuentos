---
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryMotif from '../components/CategoryMotif.astro';
import { ui, homeUrl } from '../i18n/ui';

const t = ui.es;
---

<BaseLayout
  lang="es"
  title={`${t.notFoundTitle} — Hermanos de cuento`}
  description={t.notFoundBody}
  alternates={{ es: homeUrl('es'), en: homeUrl('en') }}
>
  <article class="story">
    <div class="story-inner not-found">
      <div class="cover cover-page" style="--cover:#c9d6de"><CategoryMotif category="tradicionales" /></div>
      <h1>{t.notFoundTitle}</h1>
      <p class="story-lead">{t.notFoundBody}</p>
      <p class="story-lead" lang="en">{ui.en.notFoundBody}</p>
      <p><a class="back" href={homeUrl('es')}>{t.back}</a> · <a class="back" href={homeUrl('en')} lang="en">{ui.en.back}</a></p>
    </div>
  </article>
</BaseLayout>
